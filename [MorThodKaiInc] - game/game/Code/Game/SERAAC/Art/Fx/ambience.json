{
  // Atmosphere presets (Fx/Ambience.cs). Save while the game runs and it reloads.
  // A preset is a list of layers drawn back to front. "front": true layers go over the characters / the map
  // (in fights the band [0.22, 0.66] is where the fighters stand, from heads to feet).
  // Kinds: dust, fog, smoke, clouds, embers, wind, rays.
  // "y" = [top, bottom] of the band the layer lives in, as fractions of the screen / room (0 = top, 1 = bottom).
  // Fights: a background's "ambience" field in Art/Stages/backgrounds.json wins, else the trial's preset below.
  // Exploration rooms use the trial's preset too.
  "trials": {
    "city_outskirt": "city_outskirt",
    "city_academy": "academy"
  },

  "presets": {
